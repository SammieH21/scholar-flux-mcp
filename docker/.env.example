# =============================================================================
# ScholarFlux MCP Server Environment Configuration
# =============================================================================
# Instructions:
# Copy this file to .env and fill in the configuration to customize the server
# 
# Usage:
#   cp .env.example .env
#   # Edit .env with your API keys
#   docker compose up -d

# =============================================================================
# API Keys (Optional but recommended for better rate limits)
# =============================================================================

# PubMed API Key (Not required - higher rate limits) - Get from: https://www.ncbi.nlm.nih.gov/account/
PUBMED_API_KEY=

# Springer Nature API Key - Get from: https://dev.springernature.com/
SPRINGER_NATURE_API_KEY=

# CORE API Key (Not required - higher rate limits) - Get from: https://core.ac.uk/services/api
CORE_API_KEY=

# =============================================================================
# AI Model Configuration
# =============================================================================


# Choose between Ollama, Anthropic, or OpenAI for research synthesis.
# When a model default isn't specified, Ollama is the default for synthesis. Otherwise, Claude (Haiku) is used
SCHOLAR_FLUX_MCP_DEFAULT_MODEL_PROVIDER=
#
# The duration of time (in seconds) that PydanticAI should wait before retrying the request
SCHOLAR_FLUX_MCP_REQUEST_TIMEOUT=

# =========
# OLLAMA
# =========
# Note: Ollama requires the --profile with-ollama flag  (e.g., `docker compose --profile with-ollama up -`)
# Ollama model to use for synthesis (defaults to `devstral-2:123b-cloud`: 
SCHOLAR_FLUX_MCP_OLLAMA_MODEL=
# Uses `http://localhost:11434` inside the container by default if not explicitly specified
SCHOLAR_FLUX_MCP_OLLAMA_BASE_URL=
# Note - Cloud-based ollama models require an API key (get yours free from https://ollama.com/settings/keys)
OLLAMA_API_KEY=

# ==========
# Anthropic
# ==========

# Uses haiku-4-5 by default if not explicitly defined
SCHOLAR_FLUX_MCP_ANTHROPIC_MODEL=
# Anthropic API Key (for Claude-powered synthesis)
# Get your API key from: https://console.anthropic.com/ (pay per token)
ANTHROPIC_API_KEY=

# ==========
# OpenAI
# ==========
# Note: The OpenAI setting supports any OpenAI compatible endpoint.
# Uses gpt-5 by default if not explicitly defined
SCHOLAR_FLUX_MCP_OPENAI_MODEL=
# A provider with an OpenAI compatible endpoint (uses `openai` by default if not specified)
SCHOLAR_FLUX_MCP_OPENAI_PROVIDER=

# An OpenAI_API_KEY might not be required when using endpoints other than those for ChatGPT
# For ChatGPT, get your API key from https://platform.openai.com/api-keys (pay per token)
OPENAI_API_KEY=

# =============================================================================
# ScholarFlux Configuration
# =============================================================================

# Location where all core scholar-flux logs/cache should be added by default. If empty, $HOME/.scholar_flux is used by default.
SCHOLAR_FLUX_HOME=                                                    

# Logging level (DEBUG, INFO, WARNING, ERROR)
SCHOLAR_FLUX_LOG_LEVEL=WARNING

# Enable/disable logging for the Core ScholarFlux package
SCHOLAR_FLUX_ENABLE_LOGGING=TRUE

# =============================================================================
# Cache Configuration (Advanced)
# =============================================================================

# Layer 1—Session Cache: The backend used to cache raw requests while avoiding resending the same request.
# Possible values: (sqlite, redis, memory, mongodb, filesystem, gridfs)
SCHOLAR_FLUX_DEFAULT_SESSION_CACHE_BACKEND=

# Response cache backend (mongodb, redis, inmemory)
# Layer 2—Response Cache: The storage used to cache processed response data to avoid repeated computation.
# Possible values: (sql/sqlite, duckdb, redis, memory/inmemory, mongo/mongodb, null)
SCHOLAR_FLUX_DEFAULT_RESPONSE_CACHE_STORAGE=

# Time until cached requests become stale. Defaults 86400 seconds (24 hours)
SCHOLAR_FLUX_DEFAULT_SESSION_CACHE_TTL=86400
# Time until processing cache becomes stale. Off by default: detection of cache freshness occurs automatically
SCHOLAR_FLUX_DEFAULT_RESPONSE_CACHE_TTL=

# Redis connection (if using redis profile)
SCHOLAR_FLUX_REDIS_HOST=
SCHOLAR_FLUX_REDIS_PORT=

# MongoDB connection (if not using docker compose defaults)
SCHOLAR_FLUX_MONGODB_HOST=
SCHOLAR_FLUX_MONGODB_PORT=
